# This file holds secret values so they never appear in your actual code.
# Your code reads these using process.env.VARIABLE_NAME

DB_HOST=localhost              # where your MySQL server lives (localhost = your own machine)

# Least-privilege user for everyday login/register requests (created by
# DATABASE/roles_and_privileges.sql -- run that file BEFORE starting the server)
DB_USER=shopnest_app
DB_PASSWORD=ChangeThisAppPassword!

# Elevated user used ONLY by the admin-only route (see config/adminDatabase.js)
ADMIN_DB_USER=shopnest_admin
ADMIN_DB_PASSWORD=ChangeThisAdminPassword!

DB_NAME=shopnest               # the name of the database you're connecting to
JWT_SECRET=replace_this_with_a_long_random_string  # used to "sign" login tokens so they can't be faked
PORT=5001                      # which port your backend server will run on
